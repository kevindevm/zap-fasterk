[Desktop Entry]
Type=Application
Name=Zap Fasterk
GenericName=WhatsApp Client
Comment=A native WhatsApp client
Exec=zap-fasterk %u
Icon=zap-fasterk
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=whatsapp;chat;messaging;
StartupWMClass=zap-fasterk
MimeType=x-scheme-handler/whatsapp;
SingleMainWindow=true
Actions=quit;

[Desktop Action quit]
Name=Quit Zap Fasterk
Exec=zap-fasterk quit
