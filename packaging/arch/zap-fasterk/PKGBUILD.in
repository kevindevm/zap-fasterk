# Maintainer: kevindevm
# Original package templates: Carmine Paolino <carmine@paolino.me>
pkgname=zap-fasterk
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Fast native WhatsApp client built with Rust and egui"
arch=('x86_64' 'aarch64')
url="https://github.com/kevindevm/zap-fasterk"
license=('MIT' 'GPL-2.0-only')
install="${pkgname}.install"
depends=('alsa-lib' 'alsa-plugins' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr')
makedepends=('cargo' 'cmake' 'clang' 'perl')
optdepends=('org.freedesktop.secrets: archive encryption key storage'
            'noto-fonts-emoji: colour emoji in messages and reactions'
            'xdg-desktop-portal: the file picker for attachments')
provides=()
conflicts=('zap-fasterk-bin' 'zap-fasterk-git' 'zapfasterk' 'zapfasterk-bin' 'zapfasterk-git' 'fastsapp' 'fastsapp-bin' 'fastsapp-git')
replaces=()
# !lto because ring compiles its own C and Arch's default CFLAGS put LTO
# objects in the archive, which lld then cannot resolve: the link fails on
# undefined ring_core_* symbols. The stable package is prebuilt and never
# meets this.
options=('!debug' '!lto')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/kevindevm/zap-fasterk/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  # whatsapp-rust is a git dependency pinned to a commit; the lockfile
  # names it, so this fetches it along with everything else.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Generated bindings inside glutin carry the path they were built at, which
  # ends up in the binary and makes makepkg warn about a reference to $srcdir.
  # Appended rather than assigned, so the distro's own flags survive.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/"
  cargo build --frozen --release
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  # The demo feature carries the headless layout test of every screen,
  # which needs no display and talks to nothing.
  cargo test --frozen --features demo
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/zap-fasterk" "${pkgdir}/usr/bin/zap-fasterk"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "THIRD-PARTY-NOTICES.md" "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES.md"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "packaging/applications/zap-fasterk.desktop" \
    "${pkgdir}/usr/share/applications/zap-fasterk.desktop"
  install -Dm644 "packaging/icons/zap-fasterk.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/zap-fasterk.svg"
  # Releases predating theme integration remain valid packaging inputs.
  if [[ -f "contrib/omarchy/zap-fasterk.json.tpl" ]]; then
    install -Dm644 "contrib/omarchy/zap-fasterk.json.tpl" \
      "${pkgdir}/usr/share/zap-fasterk/omarchy/zap-fasterk.json.tpl"
    install -Dm755 "contrib/omarchy/zap-fasterk-theme" \
      "${pkgdir}/usr/share/zap-fasterk/omarchy/zap-fasterk-theme"
  fi

}
